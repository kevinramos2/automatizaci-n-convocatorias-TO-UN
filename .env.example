# Copiar a .env y completar con tus propios valores. Nunca commitear el .env real.

# Clave de la API de Anthropic (console.anthropic.com) — usada para leer y clasificar
# los documentos de cada expediente.
ANTHROPIC_API_KEY=

# ID de la hoja de cálculo de Google Sheets donde se registran las revisiones
# (el ID es la parte de la URL entre /d/ y /edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Además de estas variables, se necesita un archivo service-account.json en la raíz
# del proyecto: las credenciales de una cuenta de servicio de Google Cloud con
# acceso de Editor sobre la hoja de cálculo (Google Cloud Console → IAM → Cuentas de
# servicio → crear clave JSON). Nunca se commitea (ver .gitignore).
